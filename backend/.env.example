# Copy to .env and fill in your own values. Never commit the filled copy.

# GCP project that hosts Vertex AI and the Laya proxy.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash-lite

# Cloud Run proxy in front of the Laya GPU VM. Must include the /predict path.
LAYA_ENDPOINT=https://laya-system1-proxy-xyz123-uc.a.run.app/predict
LAYA_TIMEOUT_SECONDS=45.0
# Deadline for the header reachability probe. Must fail fast.
LAYA_PROBE_TIMEOUT_SECONDS=8.0

# TypeSafe Jev, used only by the compare mode.
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=

# Laya confidence below this value sends the question to System 2.
CONFIDENCE_THRESHOLD=0.60
MAX_SEARCH_SOURCES=5
